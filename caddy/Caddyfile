		reverse_proxy 127.0.0.1:8093
	}
}

# listadmin on this server uses http://, and does not follow redirects. /etc/hosts points this
# hostname at 127.0.0.1, so its traffic stays on this machine. Everyone else goes to HTTPS.
http://lists.fklub.dk {
	import site
	@this_server client_ip 127.0.0.1/32
	handle @this_server {
		reverse_proxy 127.0.0.1:8888
	}
	handle {
		redir https://{host}{uri} 308
	}
}

# Everything but phpMyAdmin on this hostname is Mailman, still in Apache on 127.0.0.1:8888.
lists.fklub.dk {
	import site
	import uni_network
	import login_message
	redir /phpmyadmin /phpmyadmin/ 308
	handle_path /phpmyadmin/* {
		handle @uni_network {
			reverse_proxy 127.0.0.1:8091
		}
		handle {
			import login
			reverse_proxy 127.0.0.1:8091
		}
	}
	redir / /listinfo permanent
	handle {
		reverse_proxy 127.0.0.1:8888
	}
}

stregsystemet.fklub.dk {
	import site
	redir https://stregsystem.fklub.dk{uri} permanent
}

# The allowlist is outside this repo, because it lists people's homes.
# It might get completely removed in favour of a login. See the README.
stregsystem.fklub.dk {
	import site
	import /etc/caddy/stregsystem-allowlist.caddy
	import login_message

	handle @stregsystem_allowed {
		import stregsystem_site
	}

	handle {
		import login
		import stregsystem_site
	}
}

# This moves to /srv when Stregsystem moves.
api.stregsystem.fklub.dk {
	import static /data/stregsystem/openapi/out
}
