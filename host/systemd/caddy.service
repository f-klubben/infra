[Unit]
Description=Caddy web server for the F-klubben sites
Documentation=https://github.com/f-klubben/infra
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=caddy
Group=caddy
SupplementaryGroups=www-data
Environment=XDG_DATA_HOME=/var/lib/caddy XDG_CONFIG_HOME=/var/lib/caddy
ExecStart=/usr/local/bin/caddy run --config /srv/infra/caddy/Caddyfile --adapter caddyfile
ExecReload=/usr/local/bin/caddy reload --config /srv/infra/caddy/Caddyfile --adapter caddyfile
Restart=on-failure
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/caddy /run/caddy
RuntimeDirectory=caddy
RuntimeDirectoryMode=0700
LogsDirectory=caddy
LogsDirectoryMode=0750

[Install]
WantedBy=multi-user.target
