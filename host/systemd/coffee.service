[Unit]
Description=Coffee statistics generator
After=multi-user.target

[Service]
Environment="PYTHONUTF8=1"
Environment="PYTHONIOENCODING=utf-8"
Type=simple
Restart=always
User=coffee
Group=coffee
ExecStart=/srv/coffee/venv/bin/python3 /srv/coffee/server.py
WorkingDirectory=/srv/coffee

[Install]
WantedBy=multi-user.target
